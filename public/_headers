# Security headers for every static asset Pages serves (the game page, its
# bundle, icons, og-image.png). Pages applies this file to static assets
# only — Function responses (/share, /s, /og, /api/*) set the same headers
# in code via functions/_lib/response.ts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
