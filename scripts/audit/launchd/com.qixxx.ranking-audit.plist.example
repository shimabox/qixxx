<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qixxx.ranking-audit</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__QIXXX_REPO_PATH__/scripts/audit/launchd/run-ranking-audit.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__QIXXX_REPO_PATH__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>QIXXX_REPO_PATH</key>
    <string>__QIXXX_REPO_PATH__</string>
    <key>NODE_BIN_DIR</key>
    <string>__NODE_BIN_DIR__</string>
    <key>CLOUDFLARE_ACCOUNT_ID</key>
    <string>__CLOUDFLARE_ACCOUNT_ID__</string>
    <key>CLOUDFLARE_D1_DATABASE_ID</key>
    <string>__CLOUDFLARE_D1_DATABASE_ID__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>2</integer></dict>
    <dict><key>Minute</key><integer>7</integer></dict>
    <dict><key>Minute</key><integer>12</integer></dict>
    <dict><key>Minute</key><integer>17</integer></dict>
    <dict><key>Minute</key><integer>22</integer></dict>
    <dict><key>Minute</key><integer>27</integer></dict>
    <dict><key>Minute</key><integer>32</integer></dict>
    <dict><key>Minute</key><integer>37</integer></dict>
    <dict><key>Minute</key><integer>42</integer></dict>
    <dict><key>Minute</key><integer>47</integer></dict>
    <dict><key>Minute</key><integer>52</integer></dict>
    <dict><key>Minute</key><integer>57</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/ranking-audit.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/ranking-audit.stderr.log</string>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
