{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "@cloudflare/workers-types"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowJs": false
  },
  "include": ["scripts/**/*.ts", "migrations/**/*.ts", "docs/measurements/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
